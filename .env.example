# Copy to .env and adjust: cp .env.example .env

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC

# Host port the API is published on
API_PORT=8000

# --- PostgreSQL ---
POSTGRES_DB=gsr
POSTGRES_USER=gsr
POSTGRES_PASSWORD=gsr

# --- JWT ---
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# --- Attachments ---
ATTACHMENT_MAX_SIZE_MB=10
ATTACHMENT_ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,doc,docx,txt

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- Email (Gmail SMTP) ---
# 1. Enable 2-Step Verification on the Google account.
# 2. Create an app password: https://myaccount.google.com/apppasswords
# 3. Put the account and the 16-character app password below (never your normal password).
# Gmail sends as the authenticated account, so DEFAULT_FROM_EMAIL should use that address.
# Without credentials, set EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# to print emails (incl. verification links) to the worker log instead.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=your-account@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=Service Desk <your-account@gmail.com>
EMAIL_VERIFICATION_REQUIRED=1
EMAIL_VERIFICATION_TOKEN_HOURS=24
