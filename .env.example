# Copy to .env and adjust: cp .env.example .env

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC

# Host port the API is published on
API_PORT=8000

# --- PostgreSQL ---
POSTGRES_DB=gsr
POSTGRES_USER=gsr
POSTGRES_PASSWORD=gsr

# --- JWT ---
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# --- Attachments ---
ATTACHMENT_MAX_SIZE_MB=10
ATTACHMENT_ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,doc,docx,txt

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- Email ---
# Compose ships Mailpit as a local SMTP sink: open http://localhost:8025 to read sent mail.
# Use django.core.mail.backends.console.EmailBackend to print emails to the worker log instead.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
DEFAULT_FROM_EMAIL=Service Desk <no-reply@gsr.local>
EMAIL_VERIFICATION_REQUIRED=1
EMAIL_VERIFICATION_TOKEN_HOURS=24
